[Unit]
Description=Entropy account2 io:ANTH market maker ($50-$100 randomized, isolated 5x requested)
After=network-online.target entropy-account2-guardian.service
Requires=entropy-account2-guardian.service
BindsTo=entropy-account2-guardian.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=entropy-bot
Group=entropy-bot
WorkingDirectory=/opt/entropy-bot/current/app
EnvironmentFile=/etc/entropy-bot/account2.env
LoadCredentialEncrypted=cred:/etc/credstore.encrypted/entropy-account2-grid.cred
Environment=ENTROPY_CREDENTIAL_FILE=%d/cred
Environment=ENTROPY_KEYSTORE_PATH=/etc/entropy-bot/account2-agent-keystore.json
Environment=COINS=io:ANTH
Environment=QUOTE_NOTIONAL_USD=75
Environment=QUOTE_NOTIONAL_MIN_USD=50
Environment=QUOTE_NOTIONAL_MAX_USD=100
Environment=MAX_LEVERAGE=5
Environment=MIN_EXIT_EDGE_TICKS=1
Environment=FLATTEN_FAR_S=120
Environment=FLATTEN_TAKE_S=900
Environment=FLATTEN_HARD_S=3600
Environment=IOC_MAX_LOSS_TICKS=2
Environment=ENTROPY_STATE_DIR=/var/lib/entropy-bot-account2
Environment=ENTROPY_INTENT_DB=/var/lib/entropy-bot-account2/intents.sqlite3
Environment=GUARDIAN_READY_PATH=/run/entropy-bot-account2/guardian-ready.json
Environment=GUARDIAN_LEASE_PATH=/run/entropy-bot-account2/main-lease.json
Environment=GUARDIAN_TOKEN_PATH=/run/entropy-bot-account2/guardian-session.token
ExecStart=/opt/entropy-bot/current/venv/bin/python -m entropy_bot live
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
RuntimeDirectory=entropy-bot-account2
RuntimeDirectoryMode=0700
StateDirectory=entropy-bot-account2
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
TasksMax=64
MemoryMax=512M
ReadOnlyPaths=/etc/entropy-bot/account2-agent-keystore.json
ReadWritePaths=/run/entropy-bot-account2 /var/lib/entropy-bot-account2

[Install]
WantedBy=multi-user.target