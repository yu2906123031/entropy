[Unit]
Description=Entropy independent EBOT cancellation guardian
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=entropy-bot
Group=entropy-bot
WorkingDirectory=/opt/entropy-bot/current/app
EnvironmentFile=/etc/entropy-bot/entropy.env
LoadCredentialEncrypted=keystore-password:/etc/credstore.encrypted/entropy-grid.cred
Environment=ENTROPY_CREDENTIAL_FILE=%d/keystore-password
Environment=GUARDIAN_TOKEN_PATH=/run/entropy-bot/guardian-session.token
ExecStart=/opt/entropy-bot/current/venv/bin/python -m entropy_bot guardian
Restart=on-failure
RestartSec=2
RuntimeDirectory=entropy-bot
RuntimeDirectoryMode=0700
StateDirectory=entropy-bot
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
TasksMax=64
MemoryMax=512M
ReadWritePaths=/run/entropy-bot /var/lib/entropy-bot

[Install]
WantedBy=multi-user.target
