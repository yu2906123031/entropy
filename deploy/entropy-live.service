[Unit]
Description=Entropy io:SNDK market maker ($20-$30 randomized, isolated 1x)
After=network-online.target entropy-guardian.service
Requires=entropy-guardian.service
BindsTo=entropy-guardian.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=entropy-bot
Group=entropy-bot
WorkingDirectory=/opt/entropy-bot/current/app
EnvironmentFile=/etc/entropy-bot/entropy.env
LoadCredentialEncrypted=cred:/etc/credstore.encrypted/entropy-grid.cred
Environment=ENTROPY_CREDENTIAL_FILE=%d/cred
Environment=COINS=io:SNDK
Environment=QUOTE_NOTIONAL_USD=25
Environment=QUOTE_NOTIONAL_MIN_USD=20
Environment=QUOTE_NOTIONAL_MAX_USD=30
Environment=MAX_LEVERAGE=1
Environment=MIN_EXIT_EDGE_TICKS=1
Environment=FLATTEN_FAR_S=120
Environment=FLATTEN_TAKE_S=300
Environment=GUARDIAN_TOKEN_PATH=/run/entropy-bot/guardian-session.token
ExecStart=/opt/entropy-bot/current/venv/bin/python -m entropy_bot live
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
RuntimeDirectory=entropy-bot
RuntimeDirectoryMode=0700
StateDirectory=entropy-bot
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
TasksMax=64
MemoryMax=512M
ReadWritePaths=/run/entropy-bot /var/lib/entropy-bot

[Install]
WantedBy=multi-user.target
