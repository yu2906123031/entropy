# Legacy JS grid planner
GRID_LOWER_PRICE=30
GRID_UPPER_PRICE=50
GRID_LEVELS=11
GRID_TOTAL_NOTIONAL_USD=100

# Public endpoints
HL_INFO_URL=https://api.hyperliquid.xyz/info
HL_WS_URL=wss://api.hyperliquid.xyz/ws
ENTROPY_MARKETS_URL=https://entropy.io/api/markets
ENTROPY_BUILDER_ADDRESS=0xcD254d2A328f7f67C7c6FEf930A4757516F7b601
ENTROPY_BUILDER_FEE=0

# Signed order execution remains locked unless both values are supplied.
ENTROPY_LIVE_ENABLED=false
ENTROPY_LIVE_CONFIRMATION=
# ENTROPY_PRIVATE_KEY is loaded only after both live gates pass.

# Adaptive ZEC MM. New openings are fail-closed after the strategy reset.
ENTROPY_COIN=ZEC
ENTROPY_ORDER_SIZE=0.02
ENTROPY_CAPITAL_BUDGET_USD=20
ENTROPY_MAX_NET_SIZE=0.0201
ENTROPY_MAX_LONG=0.0201
ENTROPY_MAX_SHORT=0.0201
ENTROPY_MAX_GROSS=0.0402
ENTROPY_MAX_LOSS_USD=1.0
ENTROPY_BASE_HALF_SPREAD_BPS=35
ENTROPY_TICK_SIZE=0.001
ENTROPY_LOT_SIZE=0.01
ENTROPY_PRICE_TICK=0.1
ENTROPY_LAYERS=3
ENTROPY_REPRICE_THRESHOLD_BPS=2
ENTROPY_HARD_REPRICE_THRESHOLD_BPS=8
ENTROPY_MICROPRICE_WEIGHT=0.65
ENTROPY_MAX_MICROPRICE_EDGE_BPS=4
ENTROPY_INVENTORY_SKEW_POWER=1.5
ENTROPY_CAPACITY_SKEW_STRENGTH=0.85

# Deliberate opt-in required for the rewritten adaptive live strategy.
ENTROPY_ALLOW_NEW_OPENINGS=false
ENTROPY_STRATEGY_RESET_ACK=
# Set ENTROPY_STRATEGY_RESET_ACK=adaptive-v2 only after reviewing dry-run/markout results.

# Daemon / persistence
ENTROPY_CYCLE_INTERVAL_SECONDS=60
ENTROPY_CYCLE_TIMEOUT_SECONDS=20
ENTROPY_MAX_CONSECUTIVE_FAILURES=5
ENTROPY_OBSERVATION_WINDOW=100
ENTROPY_APPROVAL_MIN_CYCLES=100
ENTROPY_MAX_BOOK_AGE_MS=3000
ENTROPY_LEDGER_PATH=runtime/entropy_zec_mm.sqlite3
ENTROPY_OPERATIONS_PATH=runtime/entropy_mm_operations.sqlite3
ENTROPY_MARKOUT_PATH=runtime/entropy_markouts.sqlite3
ENTROPY_OPERATOR_ADDRESS=0x0000000000000000000000000000000000000000
ENTROPY_LIVE_PROBE_MAX_USD=20
